{
  "name": "super-online-game",
  "version": "1.0.0",
  "description": "Epic MMORPG with real-time multiplayer, crafting, trading, and PvP",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm start",
    "build": "npm run client:build && npm run server:build",
    "client:build": "cd client && npm run build",
    "server:build": "echo 'Server build complete'",
    "install:all": "npm install && cd client && npm install",
    "test": "jest",
    "lint": "eslint .",
    "setup:db": "node scripts/setup-database.js",
    "migrate": "node scripts/migrate-database.js",
    "seed": "node scripts/seed-database.js"
  },
  "keywords": [
    "mmorpg",
    "multiplayer",
    "game",
    "websocket",
    "real-time",
    "rpg",
    "online",
    "browser-game"
  ],
  "author": "Super Game Developer",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.3",
    "mongoose": "^7.5.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "rate-limiter-flexible": "^3.0.6",
    "redis": "^4.6.8",
    "bull": "^4.11.3",
    "nodemailer": "^6.9.4",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.5",
    "joi": "^17.10.1",
    "dotenv": "^16.3.1",
    "winston": "^3.10.0",
    "uuid": "^9.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "cron": "^2.4.4",
    "ws": "^8.14.2",
    "http-proxy-middleware": "^2.0.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.1",
    "jest": "^29.6.4",
    "eslint": "^8.48.0",
    "prettier": "^3.0.3",
    "@types/node": "^20.5.9"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}